# Copy to .env (or run scripts/init-env.sh, which does it and generates the secrets for you).
# .env is ignored by git. NEVER commit real values.
# Tip: wrap values containing $ or # in single quotes, e.g. ADMIN_PASSWORD='pa$$word...'

# --- Database ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=TODO_REPLACE            # generated by scripts/init-env.sh

# --- Backend secrets ---
IP_HASH_SECRET=TODO_REPLACE               # 32+ random characters; hashes visitor IPs so they are never stored raw

# --- Your site ---
SITE_BASE_URL=http://localhost:8080       # production: https://your-domain (used for canonical links and the sitemap)
DOMAIN=TODO_REPLACE                       # production only: your domain, e.g. example.com (needed for --profile https)

# --- First admin account (created only if no admin exists yet) ---
ADMIN_EMAIL=TODO_REPLACE
ADMIN_PASSWORD=TODO_REPLACE               # at least 12 characters; delete this line after the first start

# --- Networking ---
HTTP_BIND=127.0.0.1                       # 127.0.0.1 = this machine only. Use 0.0.0.0 only if your platform needs it.
HTTP_PORT=8080
SESSION_COOKIE_SECURE=true                # false ONLY for trying the stack on plain http://localhost
